# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# daily-run logs are local dev artifacts — the durable record on Vercel is the function's console log
/logs/daily-run/*.json
!/logs/daily-run/.gitkeep

# intake audit logs are local dev artifacts — the durable record on Vercel is the function's console log
/logs/intake/*.jsonl
!/logs/intake/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local cache (project ref/pooler URL — no secrets, but not meant to be committed)
supabase/.temp/
