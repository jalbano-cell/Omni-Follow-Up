# Used as a fallback businessName on new estimates if a business record can't be read.
DEFAULT_BUSINESS_NAME="Your Business"

# Optional: protects /api/follow-ups/generate (the daily cron endpoint) from
# being triggered by anyone who finds the URL. If set, requests must send
# `Authorization: Bearer <CRON_SECRET>` — Vercel does this automatically for
# its own Cron Jobs once this is set as a project environment variable.
CRON_SECRET=

# Signs/verifies session JWTs (lib/auth.ts) — this is NOT a password, and
# rotating it logs out every business at once. Generate a random one with
# `openssl rand -hex 32` and never reuse it across projects. Each business
# has its own email + password, stored (hashed) in the Businesses table —
# see the "Accounts" section in README.md.
AUTH_SECRET=

# One Google Cloud OAuth client shared by every tenant's self-serve Gmail +
# Calendar consent flow (not a per-tenant credential — each business gets its
# own refresh token via /api/oauth/google/start, encrypted at rest). Create a
# "Web application" OAuth client at
# https://console.cloud.google.com/apis/credentials with authorized redirect
# URIs `http://localhost:3000/api/oauth/google/callback` (dev) and
# `https://<your-domain>/api/oauth/google/callback` (prod), and add
# gmail.send, gmail.readonly, and calendar.events scopes on the OAuth consent
# screen. See "Google connection" in README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts each business's Google refresh token (lib/crypto.ts, AES-256-GCM)
# before writing it to the database, which has no field-level encryption of
# its own. Generate with `openssl rand -hex 32`. Losing/rotating this key
# without a re-encryption migration means every business must reconnect Google.
TOKEN_ENCRYPTION_KEY=

# Supabase — the database (Postgres). Required; every read/write in the app
# goes through it (see lib/supabase.ts, services/db.ts, services/business.ts).
# Project URL and keys are under Project Settings > API in the Supabase
# dashboard. NEXT_PUBLIC_SUPABASE_ANON_KEY is the "publishable" key (safe to
# expose client-side, though nothing here currently does); SUPABASE_SERVICE_ROLE_KEY
# is the "secret" key (server only — bypasses Row Level Security, never
# expose it client-side). Schema lives in supabase/migrations/*.sql, applied
# via the linked Supabase CLI (`supabase db push`) — see CLAUDE.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
