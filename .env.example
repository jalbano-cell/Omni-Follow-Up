# Airtable — create a Personal Access Token at https://airtable.com/create/tokens
# with data.records:read and data.records:write scopes on your base.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Used as the default businessName on new estimates when not otherwise specified.
DEFAULT_BUSINESS_NAME="Your Business"

# Optional: protects /api/follow-ups/generate (the daily cron endpoint) from
# being triggered by anyone who finds the URL. If set, requests must send
# `Authorization: Bearer <CRON_SECRET>` — Vercel does this automatically for
# its own Cron Jobs once this is set as a project environment variable.
CRON_SECRET=

# Gmail — sends only fire when a user clicks "Send Email" on an Approved
# follow-up in the queue; nothing is ever sent automatically. Set up a Google
# Cloud OAuth client (Desktop or Web type) with the gmail.send scope, then use
# the OAuth Playground (or an equivalent one-time consent flow) as the
# GMAIL_USER_EMAIL account to mint a long-lived refresh token. See README.md
# for the full walkthrough.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=
